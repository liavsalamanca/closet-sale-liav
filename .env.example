# Copia este archivo como .env.local y llena los valores.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).

# Token de tu integración interna de Notion (empieza por "ntn_")
NOTION_TOKEN=

# Tu WhatsApp, sin "+" ni espacios (57 + número)
WHATSAPP_NUMBER=573133953900

# Tu usuario de Instagram, sin @
INSTAGRAM_USER=closetsaleliav

# Contraseña para entrar a /panel (elige una larga)
ADMIN_PASSWORD=

# Dirección pública de la web (en Vercel, ej. https://closetsaleliav.vercel.app)
SITE_URL=http://localhost:3000

# Clave larga y secreta que pegas en la extensión de Chrome
EXTENSION_API_KEY=

# (Opcional) ID de tu extensión de Chrome, para que solo ella pueda llamar a la API.
# Lo ves en chrome://extensions. Si lo dejas vacío, se acepta cualquier extensión con la clave.
EXTENSION_ID=
